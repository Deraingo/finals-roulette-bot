# Discord
DISCORD_TOKEN=your_discord_bot_token_here

# Twitch app credentials (from https://dev.twitch.tv/console/apps)
TWITCH_CLIENT_ID=your_client_id_from_dev_console
TWITCH_CLIENT_SECRET=your_client_secret_from_dev_console

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Use a different value in dev vs prod
TWITCH_WEBHOOK_SECRET=your_random_secret_here_make_it_long_and_random

# Behavior
TWITCH_REDEMPTION_TITLE=redeem_name_on_channel

# OAuth state signing — generate same way as TWITCH_WEBHOOK_SECRET
# Different value in dev vs prod
SESSION_SECRET=

# Postgres — use the EXTERNAL connection string from Render's dashboard
# Single-quote the value if your password contains $ (dotenv v17 expands $VAR otherwise)
DATABASE_URL='postgresql://user:password@host:5432/dbname'

# Optional override — set FORCE_PROD=true to test prod paths locally
# FORCE_PROD=true

#
# Seed-time only (NOT needed for runtime — used once by scripts/seedBotToken.js)
# Channels and channel IDs are no longer env vars — they live in Postgres.
# Look up bot user ID via: twitch api get users -q login=<bot_username>
#
# BOT_USER_ID=
# BOT_USERNAME=
# ACCESS_TOKEN=
# REFRESH_TOKEN=
